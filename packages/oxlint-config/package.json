{
  "name": "@pretty-cozy/oxlint-config",
  "version": "0.9.0",
  "description": "A pretty cozy collection of oxlint configs",
  "author": "Pretty Coffee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrettyCoffee/pretty-cozy"
  },
  "bugs": "https://github.com/PrettyCoffee/pretty-cozy/issues/new",
  "type": "module",
  "files": [
    "dist",
    "*.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run compile && pnpm run install-plugin",
    "clean": "node -e 'require(\"node:fs\").rmSync(\"./dist\", { force: true, recursive: true })'",
    "compile": "tsc --noEmit false",
    "install-plugin": "pnpm --dir ../eslint-plugin run build && node -e 'require(\"node:fs\").cpSync(\"../eslint-plugin/dist\", \"./dist/plugin\", { force:true, recursive:true })'",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "oxfmt": "^0.58.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0"
  },
  "dependencies": {
    "eslint-plugin-better-tailwindcss": "^4.6.1"
  },
  "devDependencies": {
    "oxfmt": "0.58.0",
    "oxlint": "1.74.0"
  }
}
