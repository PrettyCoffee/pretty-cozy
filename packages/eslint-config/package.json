{
  "name": "@pretty-cozy/eslint-config",
  "version": "0.10.0",
  "description": "A pretty cozy collection of eslint configs",
  "author": "Pretty Coffee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrettyCoffee/pretty-cozy"
  },
  "bugs": "https://github.com/PrettyCoffee/pretty-cozy/issues/new",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "pnpm run install-plugin",
    "install-plugin": "pnpm --dir ../eslint-plugin run build && node -e 'require(\"node:fs\").cpSync(\"../eslint-plugin/dist\", \"./plugin\", { force:true, recursive:true })'",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "eslint": ">=9.22.0"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "devDependencies": {
    "eslint": "9.39.5"
  }
}
