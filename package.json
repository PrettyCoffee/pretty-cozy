{
  "name": "@pretty-cozy/root",
  "version": "0.0.0",
  "description": "Collection of pretty cozy utilities to make npm workflows easier",
  "author": "Pretty Coffee",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter='./packages/*' run build",
    "publish": "pnpm run build && node ./scripts/publish.js",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@pretty-cozy/oxlint-config": "workspace:*",
    "@pretty-cozy/release-tools": "workspace:*",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "npm-run-all2": "8.0.4",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3"
  }
}
