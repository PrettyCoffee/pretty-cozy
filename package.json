{
  "name": "@pretty-cozy/root",
  "version": "0.0.0",
  "description": "Collection of pretty cozy utilities to make npm workflows easier",
  "author": "Pretty Coffee",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter='./packages/*' run build",
    "publish": "pnpm run build && node ./scripts/publish.js",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@pretty-cozy/oxlint-config": "workspace:*",
    "@pretty-cozy/release-tools": "workspace:*",
    "@types/node": "24.19.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{html,md,json,yaml}": [
      "oxfmt --write"
    ]
  }
}
